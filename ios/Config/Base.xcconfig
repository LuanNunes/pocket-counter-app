// App target settings. The environment-specific files include this one.
#include "Shared.xcconfig"

PRODUCT_NAME = PocketCounter
CURRENT_PROJECT_VERSION = 1
MARKETING_VERSION = 0.1.0

// Deliberately OUTSIDE PocketCounter/: that folder is a file-system-synchronized
// group, and a plist inside it would also be copied as a bundle resource.
INFOPLIST_FILE = Info.plist

// Without this the AppIcon set compiles into Assets.car but is never designated as the
// app icon, and the app ships blank.
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon

SUPPORTS_MACCATALYST = NO
ENABLE_USER_SCRIPT_SANDBOXING = YES
CODE_SIGN_STYLE = Automatic
